<UserControl x:Class="ReringProject.Custom.UI.BottomVisionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:ReringProject.UI"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="900">
    <!--260624 hbk Phase 61: Bottom 비전 뷰 (AV-08) — 좌측 컨트롤 패널 + 우측 뷰어 호스트 (airspace-safe)-->
    <!--Tray 와 동일한 2-컬럼 구조. Bottom 추가: Theta 결과 + 피커센터 캘 패널-->
    <UserControl.Resources>
        <Style x:Key="BottomActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E3A8A"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#172554"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CBD5E1"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--루트 Grid: 좌측 컬럼(컨트롤 패널) + 우측 컬럼(뷰어 호스트). airspace-safe — 두 컬럼은 완전히 분리된 Grid 셀-->
    <Grid Background="#E2E8F0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--좌측 컬럼: 컨트롤 패널 (네이티브 HWND 밖 — WPF 오버레이 가능)-->
        <Border Grid.Column="0" Margin="12" Padding="12" Background="#F8FAFC" CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!--260626 hbk Phase 66 D-04 — RowDefinition 1개 추가(총 8개). 동축 GroupBox=Row6, 여백=Row7.-->
                    <!--픽셀 캘리브레이션 GroupBox 추가(총 9개) — 동축=Row6, 캘리브=Row7, 여백=Row8.-->

                    <!--Row 0: 헤더-->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Bottom 비전"/>
                        <TextBlock Margin="0,4,0,0" Foreground="#475569" Text="Grab / 티칭 / Shape 검사 / 피커센터 캘"/>
                    </StackPanel>

                    <!--Row 1: 상태 라벨 (연결/대기 상태)-->
                    <Border Grid.Row="1" Margin="0,0,0,10" Padding="8,6" Background="#F1F5F9" CornerRadius="4">
                        <TextBlock x:Name="lbl_status" Text="대기" FontSize="13" Foreground="#334155"/>
                    </Border>

                    <!--Row 2: 툴바 (Grab/Live/Stop + 오프라인 이미지 로더)-->
                    <GroupBox Grid.Row="2" Header="카메라 / 이미지 로더" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <!--260626 hbk Phase 65 Plan 02 — 면 슬롯 선택 (D-01: 3D 2개 / 2D 4개). airspace-safe: 좌측 WPF 패널 내부.-->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="면 슬롯:" VerticalAlignment="Center"
                                           Foreground="#334155" Margin="0,0,8,0"
                                           FontSize="13"/>
                                <ComboBox x:Name="cmb_slot" Width="180"
                                          SelectionChanged="SlotComboBox_SelectionChanged"/>
                            </StackPanel>
                            <TextBlock x:Name="lbl_slotStatus" Margin="0,0,0,6" FontSize="12"
                                       Foreground="#475569" Text="슬롯 선택 필요" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button x:Name="btn_grab"
                                        Content="Grab"
                                        Style="{StaticResource BottomActionButtonStyle}"
                                        Click="GrabButton_Click"/>
                                <Button x:Name="btn_live"
                                        Content="Live"
                                        Style="{StaticResource BottomActionButtonStyle}"
                                        Click="LiveButton_Click"/>
                                <Button x:Name="btn_stop"
                                        Content="Stop"
                                        Style="{StaticResource BottomActionButtonStyle}"
                                        Click="StopButton_Click"/>
                                <!--260625 hbk Phase 61.1 오프라인 이미지 로더-->
                                <Button x:Name="btn_openFolder" Content="폴더 열기"
                                        Style="{StaticResource BottomActionButtonStyle}" Click="OpenFolderButton_Click"/>
                                <Button x:Name="btn_prevImage" Content="◀ 이전"
                                        Style="{StaticResource BottomActionButtonStyle}" Click="PrevImageButton_Click"/>
                                <Button x:Name="btn_nextImage" Content="다음 ▶"
                                        Style="{StaticResource BottomActionButtonStyle}" Click="NextImageButton_Click"/>
                                <Button x:Name="btn_saveImage" Content="이미지 저장"
                                        Style="{StaticResource BottomActionButtonStyle}" Click="SaveImageButton_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="lbl_loaderStatus" Margin="8,0,0,4" FontSize="12"
                                       Foreground="#475569" Text="로드된 이미지 없음" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!--Row 3: 티칭 패널 (ROI 2개 그리기 + 티칭 저장)-->
                    <!--260626 hbk Phase 65 Plan 02 — 슬롯 종속 명시 헤더-->
                    <GroupBox Grid.Row="3" Header="티칭 (선택 슬롯 · ROI 2개)" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <WrapPanel Margin="0,0,0,6">
                                <Button x:Name="btn_drawRoi1"
                                        Content="ROI 1 그리기"
                                        Style="{StaticResource BottomActionButtonStyle}"
                                        Click="DrawRoi1Button_Click"/>
                                <Button x:Name="btn_drawRoi2"
                                        Content="ROI 2 그리기"
                                        Style="{StaticResource BottomActionButtonStyle}"
                                        Click="DrawRoi2Button_Click"/>
                            </WrapPanel>
                            <Button x:Name="btn_teach"
                                    Content="티칭 저장"
                                    Style="{StaticResource BottomActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="TeachButton_Click"/>
                            <!--Phase 74: 티칭 파라미터. 비워두면 기본값(각도 Bottom 45/Tray 10, 스코어 0.5)을 쓴다.
                                 슬롯마다 대상이 달라 필요한 값이 다르므로 슬롯별 JSON 에 저장된다.-->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="각도범위:" VerticalAlignment="Center" FontSize="12" Width="66"/>
                                <TextBox x:Name="txt_angleExtent" Width="60" Height="22" FontSize="12"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="deg" VerticalAlignment="Center" FontSize="12" Margin="4,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="최소 Score:" VerticalAlignment="Center" FontSize="12" Width="66"/>
                                <TextBox x:Name="txt_minScore" Width="60" Height="22" FontSize="12"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="(0~1)" VerticalAlignment="Center" FontSize="12" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="lbl_teachStatus"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="#475569"
                                       Text="티칭 없음"
                                       TextWrapping="Wrap"/>
                            <!--Phase 74: 브러시 마스킹 패널. HALCON 창 밖(좌측 WPF 패널)이라 airspace 안전.-->
                            <ui:PatternBrushPanel x:Name="brushPanel" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!--Row 4: 검사 결과 패널 (Bottom: X/Y Offset + Theta + Score)-->
                    <GroupBox Grid.Row="4" Header="검사 결과" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <Button x:Name="btn_run"
                                    Content="검사"
                                    Style="{StaticResource BottomActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="RunButton_Click"/>
                            <!--260625 hbk Phase 61.1 시각화 토글 (airspace-safe: 좌측 패널)-->
                            <CheckBox x:Name="chk_showRoi" Content="ROI 표시" IsChecked="True" Margin="0,8,0,0"
                                      Checked="ShowRoiCheckBox_Changed" Unchecked="ShowRoiCheckBox_Changed"/>
                            <CheckBox x:Name="chk_showEdge" Content="에지 표시" IsChecked="True" Margin="0,4,0,0"
                                      Checked="ShowEdgeCheckBox_Changed" Unchecked="ShowEdgeCheckBox_Changed"/>
                            <!--Phase 74: 라이브/정지 화면에서 이미지 중심(가운데)을 눈으로 잡기 위한 전체 십자선.-->
                            <CheckBox x:Name="chk_showCenterCross" Content="중심 십자" IsChecked="False" Margin="0,4,0,0"
                                      Checked="ShowCenterCrossCheckBox_Changed" Unchecked="ShowCenterCrossCheckBox_Changed"/>
                            <!--Phase 74: 마우스 위치의 좌표와 밝기. 검사 화면과 동일한 뷰어 이벤트를 쓴다.-->
                            <TextBlock x:Name="lbl_hoverInfo" Text="X: -  Y: -  Gray: -" Margin="0,6,0,0"
                                       FontSize="12" Foreground="#475569"/>
                            <TextBlock x:Name="lbl_result"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="#334155"
                                       Text="결과 없음"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!--Row 5: 피커센터 캘리브레이션 패널 (Bottom 전용 — AV-05)-->
                    <GroupBox Grid.Row="5" Header="피커센터 캘" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <!--Phase 74: 캘 스텝당 피커 회전각. 검사용 각도범위와는 별개다.
                                 10도 → 36스텝, 20도 → 18스텝, 30도 → 12스텝.-->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="스텝 각도:" VerticalAlignment="Center" FontSize="12" Width="66"/>
                                <ComboBox x:Name="cmb_calStepAngle" Width="70" Height="22" FontSize="12"
                                          SelectionChanged="CalStepAngleComboBox_SelectionChanged">
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="20"/>
                                    <ComboBoxItem Content="30"/>
                                </ComboBox>
                                <TextBlock x:Name="lbl_calStepInfo" Text="deg · 36스텝" VerticalAlignment="Center"
                                           FontSize="12" Margin="6,0,0,0"/>
                            </StackPanel>
                            <!--260901 hbk quick-mc1 — find_shape_model 최소 Score. 지그 검출이 안 될 때
                                 현장에서 낮춰볼 수 있게 노출. 등급 기준(FindMinScore)도 이 값을 그대로 따라간다.-->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="최소 Score:" VerticalAlignment="Center" FontSize="12" Width="66"/>
                                <ComboBox x:Name="cmb_calFindMinScore" Width="70" Height="22" FontSize="12"
                                          SelectionChanged="CalFindMinScoreComboBox_SelectionChanged">
                                    <ComboBoxItem Content="0.3"/>
                                    <ComboBoxItem Content="0.4"/>
                                    <ComboBoxItem Content="0.5"/>
                                    <ComboBoxItem Content="0.6"/>
                                    <ComboBoxItem Content="0.7"/>
                                </ComboBox>
                            </StackPanel>
                            <!--초기화: 누적 스텝 클리어-->
                            <Button x:Name="btn_calReset"
                                    Content="초기화"
                                    Style="{StaticResource BottomActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="CalResetButton_Click"/>
                            <!--검색 ROI(원) 지정: Circle 드로잉 시작-->
                            <Button x:Name="btn_calDrawRoi"
                                    Content="검색 ROI(원) 지정"
                                    Style="{StaticResource BottomActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="CalDrawRoiButton_Click"/>
                            <!--Cal 모델 티칭: Grab → ROI 내 ShapeModel 생성/저장-->
                            <Button x:Name="btn_calTeachModel"
                                    Content="Cal 모델 티칭"
                                    Style="{StaticResource BottomActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="CalTeachModelButton_Click"/>
                            <!--스텝 추가: Grab + find_shape_model → 중심 누적-->
                            <Button x:Name="btn_calAddStep"
                                    Content="스텝 추가 (Grab+검출)"
                                    Style="{StaticResource BottomActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="CalAddStepButton_Click"/>
                            <!--피커센터 계산: 누적 지그 중심 → 편심원 피팅-->
                            <Button x:Name="btn_calCompute"
                                    Content="피커센터 계산"
                                    Style="{StaticResource BottomActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="CalComputeButton_Click"/>
                            <!--캘 상태: 누적 스텝 수 표시-->
                            <TextBlock x:Name="lbl_calStatus"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="#475569"
                                       Text="누적 0"
                                       TextWrapping="Wrap"/>
                            <!--피커센터 결과: 산출된 row/col/radius 표시-->
                            <TextBlock x:Name="lbl_pickerCenter"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="#1E3A8A"
                                       Text=""
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!--260626 hbk Phase 66 D-04 — 동축 조명 컨트롤(ALIGN_COAX 단일 채널). airspace-safe: 좌측 WPF 패널 내부.-->
                    <GroupBox Grid.Row="6" Header="동축 조명 (Align 전용)" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <CheckBox x:Name="chk_coaxEnabled" Content="동축 ON/OFF" Margin="0,0,0,6"
                                      Checked="CoaxCheckBox_Changed" Unchecked="CoaxCheckBox_Changed"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="밝기:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="#334155"/>
                                <Slider x:Name="sld_coaxLevel" Minimum="0" Maximum="255" Width="180"
                                        VerticalAlignment="Center" ValueChanged="CoaxSlider_ValueChanged"/>
                                <TextBlock x:Name="lbl_coaxLevel" Text="0" Margin="6,0,0,0" FontSize="12"
                                           VerticalAlignment="Center" Width="32" Foreground="#334155"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!--Row 7: 픽셀 분해능 캘리브레이션. Bottom 은 6-슬롯 모두 같은 카메라/렌즈 공유 →
                         SystemSetting.EthernetPixelResolution 단일 소스(슬롯 무관)에 직접 씀. Tray 와 동일 필드,
                         PC 가 Tray/Bottom 모드 배타(같은 PC 에서 동시에 둘 다 켜지지 않음)라 값 충돌 없음.-->
                    <GroupBox Grid.Row="7" Header="픽셀 캘리브레이션" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <WrapPanel>
                                <Button x:Name="btn_checkerboardCalibrate"
                                        Content="체커보드 캘리브"
                                        Style="{StaticResource BottomActionButtonStyle}"
                                        Click="OpenCheckerboardCalibrationButton_Click"/>
                                <Button x:Name="btn_calibrateDistance"
                                        Content="거리 캘리브"
                                        Style="{StaticResource BottomActionButtonStyle}"
                                        Click="CalibrateDistanceButton_Click"/>
                                <!--Phase 74: 거리 재기. 캘리브 값은 바꾸지 않고 두 점 사이 거리만 보여준다.-->
                                <Button x:Name="btn_measureDistance"
                                        Content="거리 측정"
                                        Style="{StaticResource BottomActionButtonStyle}"
                                        Click="MeasureDistanceButton_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="lbl_pixelCalibStatus"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="#475569"
                                       Text="캘리브 안 함"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!--Row 8: 여백 (기존 Row 7 에서 이동)-->
                    <Grid Grid.Row="8"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!--우측 컬럼: 뷰어 호스트 Border (외부 MainWindow 가 AttachSharedViewer 로 자식 주입 — D-03)-->
        <!--airspace-safe: 이 Border 는 좌측 컨트롤 패널과 완전히 분리된 Grid 셀-->
        <Border x:Name="ViewerHostBorder"
                Grid.Column="1"
                Margin="0,12,12,12"
                Background="Black"/>
    </Grid>
</UserControl>
