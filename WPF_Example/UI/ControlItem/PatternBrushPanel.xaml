<UserControl x:Class="ReringProject.UI.PatternBrushPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="360">
    <!--Phase 74: 이 패널은 HALCON 창 "밖"(호스트의 WPF 컨트롤 패널)에 놓인다.
         브러시 자국·미리보기는 뷰어가 HALCON 창 안에 직접 그리므로 여기에는 그림 요소를 두지 않는다.-->
    <GroupBox Header="브러시 마스킹 (모델 제외 영역)">
        <StackPanel Margin="8">
            <CheckBox x:Name="chk_maskEnabled" Content="브러시 마스킹 사용 (끄면 기존 동작)"
                      IsChecked="{Binding IsMaskEnabled, Mode=TwoWay}"/>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <ToggleButton x:Name="btn_brushActive" Content="칠하기 모드"
                              IsChecked="{Binding IsBrushActive, Mode=TwoWay}"
                              MinWidth="90" Height="26" Margin="0,0,6,0"/>
                <ToggleButton x:Name="btn_eraseMode" Content="지우개"
                              IsChecked="{Binding IsEraseMode, Mode=TwoWay}"
                              MinWidth="70" Height="26"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="굵기:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                <Slider x:Name="sld_brushRadius" Minimum="5" Maximum="200" Width="180"
                        VerticalAlignment="Center" Value="{Binding BrushRadiusPx, Mode=TwoWay}"/>
                <TextBlock Text="{Binding BrushRadiusPx, StringFormat={}{0:F0}px}" Width="46"
                           Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="btn_clearMask" Content="마스크 초기화"
                    Click="ClearMaskButton_Click" Height="26" Margin="0,6,0,0"/>

            <TextBlock x:Name="lbl_brushStatus" Text="{Binding StatusText}" Margin="0,6,0,0"
                       FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
        </StackPanel>
    </GroupBox>
</UserControl>
