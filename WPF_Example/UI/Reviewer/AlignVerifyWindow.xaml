<Window x:Class="ReringProject.UI.AlignVerifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Align 정합 조회" Height="820" Width="1100"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 조회 조건 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="자재번호" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Width="120" Height="24" VerticalContentAlignment="Center"
                     Text="{Binding MaterialNoText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="기간" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <DatePicker Width="130" SelectedDate="{Binding DateFrom}"/>
            <TextBlock Text="~" VerticalAlignment="Center" Margin="6,0,6,0"/>
            <DatePicker Width="130" SelectedDate="{Binding DateTo}"/>
            <TextBlock Text="최근 N개" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox Width="90" Height="24"
                      ItemsSource="{Binding RecentCountOptions}"
                      SelectedItem="{Binding RecentCount}"/>
            <Button Content="조회" Width="80" Height="26" Margin="16,0,0,0"
                    Click="Button_Query_Click"/>
        </StackPanel>

        <!-- 자재 요약 -->
        <Border Grid.Row="1" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{Binding MaterialHeaderText}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <TextBlock Text="① Align 계산" Width="120"/>
                    <TextBlock Text="{Binding AlignValueText}" Width="280"/>
                    <TextBlock Text="{Binding AlignJudgeText}" Foreground="#FF475569"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <TextBlock Text="② 안착 위치" Width="120"/>
                    <TextBlock Text="{Binding SeatValueText}" Width="280"/>
                    <TextBlock Text="{Binding SeatJudgeText}" Foreground="#FF475569"/>
                </StackPanel>
                <TextBlock Text="{Binding ConclusionText}" Margin="0,6,0,0" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LimitNoticeText}" Margin="0,4,0,0" FontSize="11"
                           Foreground="#FF9A3412" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 추세 -->
        <Border Grid.Row="2" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="최근 N개 추세" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding TrendAlignText}" Margin="0,2,0,2"/>
                <TextBlock Text="{Binding TrendSeatText}" Margin="0,2,0,2"/>
            </StackPanel>
        </Border>

        <!-- 시퀀스별 ② 집계 -->
        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Top" Text="시퀀스별 ② 안착 편차 (지그별)" FontWeight="Bold" Margin="0,0,0,4"/>
            <DataGrid ItemsSource="{Binding SeatStats}" AutoGenerateColumns="False" IsReadOnly="True"
                      FontSize="11" RowHeight="18" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="시퀀스" Binding="{Binding SequenceName}" Width="110"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding DatumName}" Width="150"/>
                    <DataGridTextColumn Header="건수" Binding="{Binding Count}" Width="70"/>
                    <DataGridTextColumn Header="평균mm" Binding="{Binding AvgDeviationMm, StringFormat={}{0:F4}}" Width="90"/>
                    <DataGridTextColumn Header="최대mm" Binding="{Binding MaxDeviationMm, StringFormat={}{0:F4}}" Width="90"/>
                    <DataGridTextColumn Header="최근mm" Binding="{Binding LastDeviationMm, StringFormat={}{0:F4}}" Width="90"/>
                    <DataGridTextColumn Header="평균px" Binding="{Binding AvgDeviationPx, StringFormat={}{0:F2}}" Width="80"/>
                    <DataGridTextColumn Header="최대px" Binding="{Binding MaxDeviationPx, StringFormat={}{0:F2}}" Width="80"/>
                    <DataGridCheckBoxColumn Header="mm환산" Binding="{Binding HasResolution}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- 조회 자재 상세 -->
        <DockPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Top" Text="조회 자재 상세" FontWeight="Bold" Margin="0,0,0,4"/>
            <DataGrid ItemsSource="{Binding DetailRows}" AutoGenerateColumns="False" IsReadOnly="True"
                      FontSize="11" RowHeight="18" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="시각" Binding="{Binding TimeText}" Width="150"/>
                    <DataGridTextColumn Header="구분" Binding="{Binding KindText}" Width="70"/>
                    <DataGridTextColumn Header="대상/시퀀스" Binding="{Binding TargetOrSequenceText}" Width="110"/>
                    <DataGridTextColumn Header="슬롯/Datum" Binding="{Binding SlotOrDatumText}" Width="150"/>
                    <DataGridTextColumn Header="값" Binding="{Binding ValueText}" Width="230"/>
                    <DataGridTextColumn Header="판정" Binding="{Binding JudgeText}" Width="90"/>
                    <DataGridTextColumn Header="이미지파일" Binding="{Binding ImageFileText}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- 알려진 한계 — 항상 고정 표시 (조건부 아님) -->
        <TextBlock Grid.Row="5" Text="{Binding KnownLimitText}" TextWrapping="Wrap"
                   FontSize="11" Foreground="#FF6B7280" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="6" Text="{Binding StatusText}" FontSize="11" Foreground="#FF475569"/>
    </Grid>
</Window>
