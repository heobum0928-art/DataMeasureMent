<Window x:Class="ReringProject.UI.ReviewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewers="clr-namespace:ReringProject.UI"
        mc:Ignorable="d"
        Title="결과 리뷰어" Height="900" Width="1500"
        WindowStartupLocation="CenterOwner">
    <!--260601 hbk Phase 40 OUT-01 D-08/D-09 — 결과 리뷰어 비모달 별도 Window-->
    <Grid>
        <!-- Row0 = 중앙/우측 헤더(라벨 한 줄) 전용. 좌측 패널은 RowSpan=2 로 두 행을 관통한다 —
             예전엔 좌측 버튼 스택(8개)이 Row0 에 있어서 Auto 높이가 그 스택에 맞춰졌고,
             라벨 한 줄뿐인 중앙/우측 헤더까지 같은 높이(약 290px)를 떠안아 큰 빈 공간이 생겼다. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--260601 hbk Phase 40 CO-40-02 UAT — GridSplitter 로 3 패널 가로 크기 조절 가능. 측정표 잘림 해소.-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="120"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="200"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="430" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측 패널: 버튼 스택(Auto) + cycle 목록(*) 을 한 Border 안에서 세로 분할.
             Row0~1 을 RowSpan 으로 관통해 Row0 의 Auto 높이 계산에서 빠진다(헤더 여백 축소의 핵심). -->
        <!--260609 hbk Phase 40 OUT-02 D-10 — 날짜 폴더 열기 + 엑셀 export 버튼 (cycle 선택 시 활성)-->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0" Background="#F0F4F8" Padding="4,3">
          <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Vertical">
                <Button x:Name="btn_loadFolder" Content="날짜 폴더 열기"
                        Click="Button_LoadFolder_Click"
                        Padding="8,4" HorizontalAlignment="Stretch"/>
                <!-- Phase 78 NGA-03: NG 만 한 엑셀 파일에 누적 (D-78-02) -->
                <Button x:Name="btn_ngAccumExport" Content="NG 누적 엑셀 저장"
                        Click="Button_NgAccumExport_Click"
                        Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                        ToolTip="열어 둔 날짜 폴더의 NG 를 NG_분석_누적.xlsx 한 파일에 추가 (이미 들어간 항목은 건너뜀)"/>
                <!-- 260612 hbk Phase 41.1 OUT-03/OUT-04 반복도 실행 UI -->
                <Separator Margin="0,6,0,6"/>
                <TextBlock Text="자재번호 (비우면 미지정)"
                           FontSize="11" Foreground="#334155"
                           Margin="0,0,0,2"/>
                <TextBox x:Name="txt_materialIndex" Text=""
                         FontSize="11" Padding="4,2"
                         Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
                <CheckBox x:Name="chk_repeatAccumulate" Content="이전 결과에 누적"
                          FontSize="11" Foreground="#334155"
                          Margin="0,0,0,4"/>
                <Button x:Name="btn_repeatRun" Content="이미지 폴더 반복 검사"
                        Click="Button_RepeatRun_Click"
                        Padding="8,4" HorizontalAlignment="Stretch"/>
                <TextBlock x:Name="lbl_repeatProgress" Text=""
                           FontSize="11" Foreground="#334155"
                           Margin="0,4,0,0" HorizontalAlignment="Center"/>
                <Button x:Name="btn_repeatExport" Content="반복도 엑셀 export"
                        Click="Button_RepeatExport_Click"
                        IsEnabled="False"
                        Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Stretch"/>
                <Button x:Name="btn_cpkReportExport" Content="CPK 리포트 export"
                        Click="Button_CpkReportExport_Click"
                        IsEnabled="False"
                        Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Stretch"/>
                <Button x:Name="btn_alignVerify" Content="Align 정합 조회"
                        Click="Button_AlignVerify_Click"
                        Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Stretch"/>
                <!-- Quick 260915-k5g R2 — 기준점·Z 범위 대기 tick 은 기본 숨김, 이 체크로 회색 표시 복귀 -->
                <CheckBox x:Name="chk_showIntermediate" Content="중간 단계도 보기"
                          FontSize="11" Foreground="#334155"
                          Margin="0,8,0,0"
                          Checked="ChkShowIntermediate_Changed" Unchecked="ChkShowIntermediate_Changed"/>
            </StackPanel>

            <!-- cycle 목록 — 남는 세로 공간 전부 사용 -->
            <ListBox x:Name="listBox_cycles" Grid.Row="1" Margin="0,6,0,0"
                     SelectionChanged="CycleList_SelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Padding="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNg}" Value="True">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsIntermediate}" Value="True">
                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <!-- 중앙 헤더 — 좌: 라벨 / 우: DualImage 가로축·세로축 토글 (헤더에 배치하여 Halcon 창 airspace 회피) -->
        <!--260601 hbk Phase 40 CO-40-04 UAT — HWindowControlWPF(네이티브 HWND)는 WPF 오버레이를 가린다.
            기존 이미지 위 오버레이 버튼이 airspace 로 안 보이던 결함 → 헤더(Row0)로 이동. 조건부 표시는 유지.-->
        <Border Grid.Row="0" Grid.Column="2" BorderBrush="Gray" BorderThickness="0,0,1,1" Background="#F0F4F8" Padding="6,1">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="이미지 / Overlay" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
                <!-- 고른 행의 원본 사진 파일명과 그 검사가 쓴 기준점 사진 파일명 (폴더에서 눈으로 찾기 위함) -->
                <TextBox x:Name="txt_photoFileNames" DockPanel.Dock="Left" Text="" VerticalAlignment="Center"
                         FontSize="11" Foreground="#334155" Margin="10,0,0,0" MaxWidth="620"
                         IsReadOnly="True" IsReadOnlyCaretVisible="False" BorderThickness="0"
                         Background="Transparent" Padding="0" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Hidden" Cursor="IBeam"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <!-- 선택한 측정 이름을 이미지 위에 표시 — 한 FAI 에 측정이 여러 개일 때 어느 선인지 식별 -->
                <CheckBox x:Name="chk_showMeasName" DockPanel.Dock="Right" Content="측정명 표시"
                          IsChecked="True" VerticalAlignment="Center" FontSize="11" Foreground="#334155"
                          Margin="12,0,0,0"
                          Checked="ChkShowMeasName_Changed" Unchecked="ChkShowMeasName_Changed"/>
                <StackPanel x:Name="panel_dualToggle" DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="Collapsed">
                    <TextBlock Text="축 전환:" VerticalAlignment="Center" FontSize="11" Foreground="#334155" Margin="0,0,6,0"/>
                    <Button x:Name="btn_axisH" Content="가로축" Click="Button_AxisHorizontal_Click"
                            Padding="10,0" Margin="0,0,4,0" MinWidth="60"/>
                    <Button x:Name="btn_axisV" Content="세로축" Click="Button_AxisVertical_Click"
                            Padding="10,0" MinWidth="60"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 우측 헤더 — 좌: 라벨 / 우: '불량만 보기' 필터 체크박스 -->
        <!--260601 hbk Phase 40 CO-40-05 UAT(hotfix3) — 불량(NG/DETECT FAIL) 행만 추려 보는 필터.-->
        <Border Grid.Row="0" Grid.Column="4" BorderBrush="Gray" BorderThickness="0,0,0,1" Background="#F0F4F8" Padding="6,1">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="측정 결과 (행 클릭 = 해당 측정만 보기)"
                           VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
                <CheckBox x:Name="chk_failOnly" DockPanel.Dock="Right" Content="불량만 보기"
                          VerticalAlignment="Center" FontSize="11" Foreground="#334155"
                          Checked="ChkFailOnly_Changed" Unchecked="ChkFailOnly_Changed"/>
            </DockPanel>
        </Border>

        <!--260601 hbk Phase 40 CO-40-02 — 좌/중 분할 드래그 핸들-->
        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Width="5" Background="#C0C8D0" ShowsPreview="True"/>
        <!--260601 hbk Phase 40 CO-40-02 — 중/우 분할 드래그 핸들 (측정표 가로 폭 조절)-->
        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="3"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Width="5" Background="#C0C8D0" ShowsPreview="True"/>

        <!-- 중앙: HalconViewerControl 인스턴스 (독립, 라이브 MainView halconViewer 재사용 금지 — RESEARCH Anti-Pattern) -->
        <!--260601 hbk Phase 40 CO-40-04 — DualImage 토글은 헤더(Row0)로 이동 (HWindowControlWPF airspace 회피). 이 셀에는 오버레이 두지 않음.-->
        <viewers:HalconViewerControl x:Name="halconViewer" Grid.Row="1" Grid.Column="2" Margin="1"/>

        <!-- 우측: 측정 결과 DataGrid + NG 원인 패널 -->
        <!-- Phase 78 NGA-02: 측정표 아래(Halcon 창과 겹치지 않는 WPF 영역) NG 원인 패널 -->
        <Grid Grid.Row="1" Grid.Column="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="dataGrid_measurements"
                  Grid.Row="0"
                  SelectionChanged="MeasurementGrid_SelectionChanged"
                  SelectionMode="Single"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  FontSize="11"
                  RowHeight="18"
                  GridLinesVisibility="Horizontal"
                  Margin="1">
            <!-- 행 높이/폰트/여백 축소 — 한 화면에 보이는 측정 행 수를 늘린다(기본 대비 약 1.6배). -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="3,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="3,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.CellStyle>
            <!--260601 hbk Phase 40 CO-40-05 UAT — 불량 위치 식별: 판정별 행 배경색 (NG=빨강 / DETECT FAIL=주황 / OK=연녹).
                IsSelected 트리거는 DataTrigger 뒤에 두어 우선 적용 — 자동/수동 선택 행을 행 색상 위에 굵게+파란 테두리로 강조.-->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding JudgeText}" Value="NG">
                            <Setter Property="Background" Value="#FFD6D6"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding JudgeText}" Value="DETECT FAIL">
                            <Setter Property="Background" Value="#FFE3C2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding JudgeText}" Value="OK">
                            <Setter Property="Background" Value="#E2F3E5"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding JudgeText}" Value="측정실패">
                            <Setter Property="Background" Value="#FFD6D6"/>
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="#1565C0"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Shot"    Binding="{Binding ShotName}"       Width="70"/>
                <DataGridTextColumn Header="FAI"     Binding="{Binding FAIName}"        Width="70"/>
                <DataGridTextColumn Header="측정명"  Binding="{Binding MeasurementName}" Width="100"/>
                <DataGridTextColumn Header="Nominal" Binding="{Binding NominalValue, StringFormat=F4}" Width="65"/>
                <DataGridTextColumn Header="Tol+"    Binding="{Binding TolerancePlus, StringFormat=F4}"  Width="55"/>
                <DataGridTextColumn Header="Tol-"    Binding="{Binding ToleranceMinus, StringFormat=F4}" Width="55"/>
                <DataGridTextColumn Header="측정값"  Binding="{Binding ResultDisplay}"  Width="75"/>
                <DataGridTextColumn Header="사용 Z"  Binding="{Binding SelectedZText}"  Width="55"/>
                <DataGridTextColumn Header="기준"    Binding="{Binding RefSourceText}"   Width="70"/>
                <DataGridTextColumn Header="판정"    Binding="{Binding JudgeText}"      Width="65"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border x:Name="border_ngCause" Grid.Row="1" BorderBrush="Gray" BorderThickness="0,1,0,0" Background="#FFF8E1" Padding="6,4">
            <StackPanel>
                <TextBlock x:Name="txt_ngCauseHeader" Text="NG 원인 분석 (추정)" FontSize="11" Foreground="Gray"/>
                <TextBlock x:Name="txt_ngCausePanel" FontSize="12" TextWrapping="Wrap" Foreground="#334155"
                           Text="{Binding SelectedItem.CausePanelText, ElementName=dataGrid_measurements, FallbackValue='NG 행을 누르면 추정 원인이 여기에 보입니다', TargetNullValue='NG 행을 누르면 추정 원인이 여기에 보입니다'}"/>

                <!--Phase 80 D-80-01/02: 원인 설명 바로 아래, 큰 버튼 1개 + 비활성 이유 1줄. 더블클릭·우클릭 메뉴 없음.-->
                <Grid x:Name="panel_reinspect" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btn_applyRowToMain" Grid.Column="0"
                            Content="이 사진으로 파라미터 수정" FontSize="15" FontWeight="Bold" Padding="14,8" MinHeight="38"
                            Background="#1565C0" Foreground="White"
                            IsEnabled="{Binding CanApply}" Click="Button_ApplyRowToMain_Click"
                            ToolTip="이 검사의 사진(같은 자재의 Shot·기준점 사진)을 메인 화면에 불러옵니다. 레시피의 원래 사진 경로는 바뀌지 않습니다"/>
                    <TextBlock x:Name="txt_applyRowReason" Grid.Column="1" Text="{Binding DisableReasonText}"
                               FontSize="12" Foreground="#B45309" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
